{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "experience-evaluation-c-matrix-cell/v0.4",
  "type": "object",
  "required": [
    "cell_id",
    "subject_id",
    "dimension_id",
    "axis_contract_id",
    "source_scale_id",
    "canonical_scale_id",
    "status"
  ],
  "properties": {
    "cell_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "dimension_id": {"enum": ["reasoning", "coding", "agentic_coding", "mathematics", "data_analysis", "language", "instruction_following"]},
    "axis_contract_id": {"const": "livebench-capability-seven/v0.1"},
    "source_scale_id": {"const": "canonical_logit/v0.1"},
    "canonical_scale_id": {"const": "canonical_logit/v0.1"},
    "value": {"type": ["number", "null"]},
    "stderr": {"type": ["number", "null"], "minimum": 0},
    "canonical_value": {"type": ["number", "null"]},
    "canonical_stderr": {"type": ["number", "null"], "minimum": 0},
    "status": {"enum": ["available", "unavailable"]},
    "evidence_origin": {"type": ["string", "null"]},
    "publication_scope": {"enum": ["real_evidence", "local_controlled", "synthetic_only", "shadow", null]}
  },
  "additionalProperties": true
}
